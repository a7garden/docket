{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "docket",
	"version": "0.1.0",
	"identifier": "com.seesun.docket",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "docket",
				"width": 1380,
				"height": 880,
				"minWidth": 1040,
				"minHeight": 640,
				"decorations": false,
				"center": true,
				"backgroundColor": "#161616",
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
